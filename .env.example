# Copy to .env (gitignored) in the main checkout; worktrees get it through
# .worktreeinclude or the SessionStart hook in .claude/settings.json.

# Required: read by src/dispatch/jobs.py (Databricks SDK, also MLflow) and
# src/publish/lakehouse.py (SQL warehouse). Same values as the GitHub Actions secrets.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=
# SQL warehouse → Connection details → HTTP path, e.g. /sql/1.0/warehouses/<id>
DATABRICKS_HTTP_PATH=

# Optional: pin a bundle job instead of looking it up by name (src/dispatch/jobs.py _job_id).
# Needed when more than one job matches, e.g. dev and prod targets both deployed.
# PROCESS_SESSION_JOB_ID=
# BUILD_FEATURES_JOB_ID=
# BACKFILL_ROUND_JOB_ID=
