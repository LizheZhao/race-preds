{
  "$defs": {
    "Circuit": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "locality": {
          "title": "Locality",
          "type": "string"
        },
        "country": {
          "title": "Country",
          "type": "string"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "length_km": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Km"
        },
        "race_laps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Race Laps"
        },
        "outline": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 3,
          "title": "Outline",
          "type": "array"
        },
        "corners": {
          "items": {
            "$ref": "#/$defs/Corner"
          },
          "title": "Corners",
          "type": "array"
        },
        "past_winners": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PastWinner"
          },
          "title": "Past Winners",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "locality",
        "country",
        "lat",
        "lon",
        "outline",
        "corners"
      ],
      "title": "Circuit",
      "type": "object"
    },
    "Corner": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "letter": {
          "default": "",
          "title": "Letter",
          "type": "string"
        },
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "number",
        "x",
        "y"
      ],
      "title": "Corner",
      "type": "object"
    },
    "Driver": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Z]{3}$",
          "title": "Code",
          "type": "string"
        },
        "number": {
          "maximum": 99,
          "minimum": 0,
          "title": "Number",
          "type": "integer"
        },
        "first_name": {
          "title": "First Name",
          "type": "string"
        },
        "last_name": {
          "title": "Last Name",
          "type": "string"
        },
        "team_id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Team Id",
          "type": "string"
        },
        "headshot_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headshot Url"
        }
      },
      "required": [
        "id",
        "code",
        "number",
        "first_name",
        "last_name",
        "team_id"
      ],
      "title": "Driver",
      "type": "object"
    },
    "DriverStanding": {
      "additionalProperties": false,
      "properties": {
        "driver_id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Driver Id",
          "type": "string"
        },
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "points": {
          "minimum": 0,
          "title": "Points",
          "type": "number"
        },
        "wins": {
          "minimum": 0,
          "title": "Wins",
          "type": "integer"
        }
      },
      "required": [
        "driver_id",
        "position",
        "points",
        "wins"
      ],
      "title": "DriverStanding",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "artifact": {
          "enum": [
            "index",
            "manifest",
            "event",
            "weather",
            "finishing_order",
            "qualifying",
            "race_incidents",
            "strategy",
            "facts",
            "results"
          ],
          "title": "Artifact",
          "type": "string"
        },
        "season": {
          "minimum": 1950,
          "title": "Season",
          "type": "integer"
        },
        "round": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round"
        },
        "stage": {
          "anyOf": [
            {
              "enum": [
                "pre_weekend",
                "FP1",
                "FP2",
                "FP3",
                "SQ",
                "S",
                "Q",
                "R"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "season",
        "generated_at",
        "run_id"
      ],
      "title": "Meta",
      "type": "object"
    },
    "PastWinner": {
      "additionalProperties": false,
      "properties": {
        "season": {
          "title": "Season",
          "type": "integer"
        },
        "driver_name": {
          "title": "Driver Name",
          "type": "string"
        },
        "team_name": {
          "title": "Team Name",
          "type": "string"
        }
      },
      "required": [
        "season",
        "driver_name",
        "team_name"
      ],
      "title": "PastWinner",
      "type": "object"
    },
    "Session": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "FP1",
            "FP2",
            "FP3",
            "SQ",
            "S",
            "Q",
            "R"
          ],
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "start_utc": {
          "format": "date-time",
          "title": "Start Utc",
          "type": "string"
        },
        "status": {
          "enum": [
            "upcoming",
            "live",
            "completed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "start_utc",
        "status"
      ],
      "title": "Session",
      "type": "object"
    },
    "Standings": {
      "additionalProperties": false,
      "properties": {
        "after_round": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "After Round"
        },
        "drivers": {
          "items": {
            "$ref": "#/$defs/DriverStanding"
          },
          "title": "Drivers",
          "type": "array"
        },
        "teams": {
          "items": {
            "$ref": "#/$defs/TeamStanding"
          },
          "title": "Teams",
          "type": "array"
        }
      },
      "required": [
        "after_round",
        "drivers",
        "teams"
      ],
      "title": "Standings",
      "type": "object"
    },
    "Team": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "color"
      ],
      "title": "Team",
      "type": "object"
    },
    "TeamStanding": {
      "additionalProperties": false,
      "properties": {
        "team_id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Team Id",
          "type": "string"
        },
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "points": {
          "minimum": 0,
          "title": "Points",
          "type": "number"
        },
        "wins": {
          "minimum": 0,
          "title": "Wins",
          "type": "integer"
        }
      },
      "required": [
        "team_id",
        "position",
        "points",
        "wins"
      ],
      "title": "TeamStanding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Defines every entity other documents refer to. Written Thursday, updated for substitutions.",
  "properties": {
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "official_name": {
      "title": "Official Name",
      "type": "string"
    },
    "format": {
      "enum": [
        "conventional",
        "sprint_qualifying"
      ],
      "title": "Format",
      "type": "string"
    },
    "circuit": {
      "$ref": "#/$defs/Circuit"
    },
    "sessions": {
      "items": {
        "$ref": "#/$defs/Session"
      },
      "title": "Sessions",
      "type": "array"
    },
    "teams": {
      "items": {
        "$ref": "#/$defs/Team"
      },
      "title": "Teams",
      "type": "array"
    },
    "drivers": {
      "items": {
        "$ref": "#/$defs/Driver"
      },
      "title": "Drivers",
      "type": "array"
    },
    "standings": {
      "$ref": "#/$defs/Standings"
    }
  },
  "required": [
    "meta",
    "name",
    "official_name",
    "format",
    "circuit",
    "sessions",
    "teams",
    "drivers",
    "standings"
  ],
  "title": "EventDoc",
  "type": "object",
  "$id": "race-preds/v1/event"
}
