{
  "$defs": {
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "driver",
            "team",
            "circuit",
            "history",
            "telemetry",
            "weekend"
          ],
          "title": "Category",
          "type": "string"
        },
        "headline": {
          "maxLength": 100,
          "title": "Headline",
          "type": "string"
        },
        "body": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "driver_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9_]+$",
            "type": "string"
          },
          "title": "Driver Ids",
          "type": "array"
        },
        "team_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9_]+$",
            "type": "string"
          },
          "title": "Team Ids",
          "type": "array"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "category",
        "headline",
        "source"
      ],
      "title": "Fact",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "artifact": {
          "enum": [
            "index",
            "manifest",
            "event",
            "weather",
            "finishing_order",
            "qualifying",
            "race_incidents",
            "strategy",
            "facts",
            "results"
          ],
          "title": "Artifact",
          "type": "string"
        },
        "season": {
          "minimum": 1950,
          "title": "Season",
          "type": "integer"
        },
        "round": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round"
        },
        "stage": {
          "anyOf": [
            {
              "enum": [
                "pre_weekend",
                "FP1",
                "FP2",
                "FP3",
                "SQ",
                "S",
                "Q",
                "R"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "season",
        "generated_at",
        "run_id"
      ],
      "title": "Meta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "facts"
  ],
  "title": "FactsDoc",
  "type": "object",
  "$id": "race-preds/v1/facts"
}
