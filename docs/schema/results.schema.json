{
  "$defs": {
    "DriverPace": {
      "additionalProperties": false,
      "properties": {
        "driver_id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Driver Id",
          "type": "string"
        },
        "lap_times_s": {
          "items": {
            "type": "number"
          },
          "title": "Lap Times S",
          "type": "array"
        },
        "compounds": {
          "default": [],
          "items": {
            "enum": [
              "SOFT",
              "MEDIUM",
              "HARD",
              "INTERMEDIATE",
              "WET"
            ],
            "type": "string"
          },
          "title": "Compounds",
          "type": "array"
        }
      },
      "required": [
        "driver_id",
        "lap_times_s"
      ],
      "title": "DriverPace",
      "type": "object"
    },
    "DriverStrategy": {
      "additionalProperties": false,
      "properties": {
        "driver_id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Driver Id",
          "type": "string"
        },
        "stints": {
          "items": {
            "$ref": "#/$defs/Stint"
          },
          "minItems": 1,
          "title": "Stints",
          "type": "array"
        }
      },
      "required": [
        "driver_id",
        "stints"
      ],
      "title": "DriverStrategy",
      "type": "object"
    },
    "IncidentCounts": {
      "additionalProperties": false,
      "properties": {
        "safety_cars": {
          "minimum": 0,
          "title": "Safety Cars",
          "type": "integer"
        },
        "vscs": {
          "minimum": 0,
          "title": "Vscs",
          "type": "integer"
        },
        "red_flags": {
          "minimum": 0,
          "title": "Red Flags",
          "type": "integer"
        }
      },
      "required": [
        "safety_cars",
        "vscs",
        "red_flags"
      ],
      "title": "IncidentCounts",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "artifact": {
          "enum": [
            "index",
            "manifest",
            "event",
            "weather",
            "finishing_order",
            "qualifying",
            "sprint_qualifying",
            "sprint",
            "race_incidents",
            "strategy",
            "facts",
            "results"
          ],
          "title": "Artifact",
          "type": "string"
        },
        "season": {
          "minimum": 1950,
          "title": "Season",
          "type": "integer"
        },
        "round": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round"
        },
        "stage": {
          "anyOf": [
            {
              "enum": [
                "pre_weekend",
                "FP1",
                "FP2",
                "FP3",
                "SQ",
                "S",
                "Q",
                "R"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "season",
        "generated_at",
        "run_id"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Neutralisation": {
      "additionalProperties": false,
      "description": "One period of a race under the safety car, the virtual safety car or a red flag, in the\nleader's laps. Every lap the status was active in counts, so an SC deployed late in lap 12\nand in for laps 13-16 is 12-16.",
      "properties": {
        "kind": {
          "enum": [
            "SC",
            "VSC",
            "RED"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start_lap": {
          "minimum": 1,
          "title": "Start Lap",
          "type": "integer"
        },
        "end_lap": {
          "minimum": 1,
          "title": "End Lap",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "start_lap",
        "end_lap"
      ],
      "title": "Neutralisation",
      "type": "object"
    },
    "QualiRow": {
      "additionalProperties": false,
      "properties": {
        "driver_id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Driver Id",
          "type": "string"
        },
        "position": {
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "q1_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q1 S"
        },
        "q2_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q2 S"
        },
        "q3_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q3 S"
        }
      },
      "required": [
        "driver_id",
        "position"
      ],
      "title": "QualiRow",
      "type": "object"
    },
    "RaceRow": {
      "additionalProperties": false,
      "properties": {
        "driver_id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Driver Id",
          "type": "string"
        },
        "grid": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grid"
        },
        "position": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "classified_as": {
          "title": "Classified As",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "points": {
          "minimum": 0,
          "title": "Points",
          "type": "number"
        },
        "laps": {
          "minimum": 0,
          "title": "Laps",
          "type": "integer"
        }
      },
      "required": [
        "driver_id",
        "classified_as",
        "status",
        "points",
        "laps"
      ],
      "title": "RaceRow",
      "type": "object"
    },
    "Stint": {
      "additionalProperties": false,
      "properties": {
        "compound": {
          "enum": [
            "SOFT",
            "MEDIUM",
            "HARD",
            "INTERMEDIATE",
            "WET"
          ],
          "title": "Compound",
          "type": "string"
        },
        "start_lap": {
          "minimum": 1,
          "title": "Start Lap",
          "type": "integer"
        },
        "end_lap": {
          "minimum": 1,
          "title": "End Lap",
          "type": "integer"
        }
      },
      "required": [
        "compound",
        "start_lap",
        "end_lap"
      ],
      "title": "Stint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Actual outcomes, filled in session by session. Also the ground truth for grading snapshots.",
  "properties": {
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "sprint_qualifying": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/QualiRow"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sprint Qualifying"
    },
    "qualifying": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/QualiRow"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qualifying"
    },
    "sprint": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/RaceRow"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sprint"
    },
    "race": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/RaceRow"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Race"
    },
    "race_incidents": {
      "anyOf": [
        {
          "$ref": "#/$defs/IncidentCounts"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "race_neutralisations": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Neutralisation"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Race Neutralisations"
    },
    "race_strategies": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/DriverStrategy"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Race Strategies"
    },
    "race_pace": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/DriverPace"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Race Pace"
    }
  },
  "required": [
    "meta"
  ],
  "title": "ResultsDoc",
  "type": "object",
  "$id": "race-preds/v1/results"
}
